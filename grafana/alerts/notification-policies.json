{
  "receiver": "homelab-alerts",
  "group_by": ["alertname"],
  "group_wait": "30s",
  "group_interval": "5m",
  "repeat_interval": "24h",
  "routes": [
    {
      "receiver": "homelab-alerts",
      "matchers": ["severity=\"critical\""],
      "group_wait": "0s",
      "group_interval": "5m",
      "repeat_interval": "4h"
    },
    {
      "receiver": "homelab-alerts",
      "matchers": ["severity=\"info\""],
      "group_wait": "30s",
      "group_interval": "1h",
      "repeat_interval": "168h"
    }
  ]
}
