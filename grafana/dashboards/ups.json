{
 "uid": "ups-nut",
 "title": "ИБП (NUT)",
 "description": "APC Back-UPS XS 1400U на ноде Proxmox. Метрики собирает /usr/local/bin/ups-prom в textfile-коллектор node_exporter (репозиторий homelab/proxmox, тег nut), VictoriaMetrics скрейпит их job'ом node.",
 "tags": [
  "ups",
  "nut",
  "victoriametrics",
  "homelab"
 ],
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "type": "datasource",
    "name": "DS",
    "label": "Источник данных",
    "query": "prometheus",
    "current": {},
    "hide": 0,
    "refresh": 1,
    "regex": ""
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Обзор",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "stat",
   "title": "Питание",
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {},
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "От батареи",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "От сети",
         "color": "green",
         "index": 1
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_status_flag{job=\"node\",flag=\"OL\"}",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "description": "1 = работа от сети, 0 = от батареи. Флаг OL из ups.status."
  },
  {
   "type": "gauge",
   "title": "Заряд батареи",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 20
       },
       {
        "color": "yellow",
        "value": 50
       },
       {
        "color": "green",
        "value": 80
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_battery_charge_percent{job=\"node\"}",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdMarkers": true
   },
   "description": "Красная зона — ниже battery.charge.low (10 %), на этом пороге upsmon объявляет FSD."
  },
  {
   "type": "stat",
   "title": "Автономия",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {}
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_battery_runtime_seconds{job=\"node\"}",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "description": "Расчёт самого UPS при текущей нагрузке. Порог battery.runtime.low — 120 с."
  },
  {
   "type": "gauge",
   "title": "Нагрузка",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 60
       },
       {
        "color": "red",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_load_percent{job=\"node\"}",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdMarkers": true
   },
   "description": "Процент от 700 Вт номинала."
  },
  {
   "type": "stat",
   "title": "Мощность",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "custom": {}
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_load_percent{job=\"node\"} * ups_realpower_nominal_watts{job=\"node\"} / 100",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "description": "ups.load × ups.realpower.nominal / 100. Самой мощности в ваттах Back-UPS XS не отдаёт."
  },
  {
   "type": "stat",
   "title": "Вход",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "volt",
     "custom": {}
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_input_voltage_volts{job=\"node\"}",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "description": "На батарее это поле не обновляется — остаётся последнее значение до отключения."
  },
  {
   "type": "row",
   "title": "История",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 5
   }
  },
  {
   "type": "timeseries",
   "title": "Входное напряжение",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "volt",
     "custom": {
      "fillOpacity": 0,
      "lineWidth": 1,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "none"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_input_voltage_volts{job=\"node\"}",
     "legendFormat": "вход",
     "editorMode": "code",
     "range": true
    },
    {
     "refId": "B",
     "expr": "ups_input_transfer_low_volts{job=\"node\"}",
     "legendFormat": "порог перехода вниз",
     "editorMode": "code",
     "range": true
    },
    {
     "refId": "C",
     "expr": "ups_input_transfer_high_volts{job=\"node\"}",
     "legendFormat": "порог перехода вверх",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "min",
      "max",
      "lastNotNull"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Выход за пороги 155/280 В переводит UPS на батарею (input.transfer.reason)."
  },
  {
   "type": "timeseries",
   "title": "Заряд и нагрузка",
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "fillOpacity": 0,
      "lineWidth": 1,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "none"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_battery_charge_percent{job=\"node\"}",
     "legendFormat": "заряд",
     "editorMode": "code",
     "range": true
    },
    {
     "refId": "B",
     "expr": "ups_load_percent{job=\"node\"}",
     "legendFormat": "нагрузка",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "min",
      "max",
      "lastNotNull"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Автономия",
   "id": 12,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 0,
      "lineWidth": 1,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "none"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_battery_runtime_seconds{job=\"node\"}",
     "legendFormat": "расчётное время",
     "editorMode": "code",
     "range": true
    },
    {
     "refId": "B",
     "expr": "ups_battery_runtime_low_seconds{job=\"node\"}",
     "legendFormat": "порог LOWBATT",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "min",
      "max",
      "lastNotNull"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Если расчётное время падает до порога, upsmon объявляет FSD не дожидаясь таймера."
  },
  {
   "type": "timeseries",
   "title": "Напряжение батареи",
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {
     "unit": "volt",
     "custom": {
      "fillOpacity": 0,
      "lineWidth": 1,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "none"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_battery_voltage_volts{job=\"node\"}",
     "legendFormat": "батарея",
     "editorMode": "code",
     "range": true
    },
    {
     "refId": "B",
     "expr": "ups_battery_voltage_nominal_volts{job=\"node\"}",
     "legendFormat": "номинал",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "min",
      "max",
      "lastNotNull"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "state-timeline",
   "title": "Флаги ups.status",
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "OL — от сети, OB — от батареи, LB — низкий заряд, CHRG/DISCHRG — заряд и разряд, RB — пора менять батарею, FSD — объявлено выключение.",
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 22
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "fillOpacity": 80,
      "lineWidth": 0
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "нет",
         "color": "dark-blue",
         "index": 0
        },
        "1": {
         "text": "да",
         "color": "orange",
         "index": 1
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_status_flag{job=\"node\"}",
     "legendFormat": "{{flag}}",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "single",
     "sort": "none"
    }
   }
  },
  {
   "type": "row",
   "title": "Диагностика",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 29
   }
  },
  {
   "type": "stat",
   "title": "Связь с UPS",
   "id": 20,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 30
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {},
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "нет",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "есть",
         "color": "green",
         "index": 1
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_up{job=\"node\"}",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "description": "0 = upsc не смог прочитать данные. Сам сборщик при этом продолжает писать файл."
  },
  {
   "type": "stat",
   "title": "Свежесть метрик",
   "id": 21,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 30
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {}
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - node_textfile_mtime_seconds{job=\"node\",file=~\".*ups.prom\"}",
     "editorMode": "code",
     "range": true
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "description": "Сколько прошло с последней записи ups.prom. Таймер ups-prom.timer ходит раз в 30 с."
  },
  {
   "type": "table",
   "title": "Устройство",
   "id": 22,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 16,
    "x": 8,
    "y": 30
   },
   "fieldConfig": {
    "defaults": {
     "custom": {}
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ups_info{job=\"node\"}",
     "format": "table",
     "instant": true,
     "editorMode": "code",
     "range": false
    }
   ],
   "options": {
    "showHeader": true
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "job": true
      },
      "renameByName": {
       "model": "Модель",
       "serial": "Серийный номер",
       "firmware": "Прошивка",
       "driver": "Драйвер NUT",
       "mfr": "Производитель",
       "instance": "Экспортер",
       "nodename": "Нода"
      }
     }
    }
   ]
  }
 ]
}